<?xml version="1.0" encoding="utf-8"?>
<!-- the Android robot in its toolbox, with no tile behind it: the background layer is see-through and every pixel of the
     picture is within 34 dp of the centre (inside the 36 dp of the smallest mask, the circle), so no launcher shape cuts it -->
<adaptive-icon
  xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@android:color/transparent" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
